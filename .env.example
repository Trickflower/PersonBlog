# Copy to .env and edit locally. Never commit .env.
AI_PROVIDER=disabled
# Providers: disabled, openai (Responses API), compatible (Chat Completions).
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Optional, improves the rate limit for GitHub discovery.
GITHUB_TOKEN=
# Needed only when config/knowledge.json sources.search.provider is brave or tavily.
SEARCH_API_KEY=
# Optional overrides for publishing, without protocol for SITE_BASE_URL.
SITE_BASE_URL=
SITE_REPOSITORY=
STUDIO_PORT=4312
